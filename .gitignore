# --- Data: never committed --------------------------------------------------
# All three sources are re-fetchable; see data/README.md for provenance.
# Keeping raw data out of git also avoids any redistribution question under
# ODbL (MIMIC demo) and CC BY 4.0 (Isfahan). Licence files ARE tracked.
data/isfahan/*.csv
data/isfahan/*.docx
data/mimic_ed_demo/*.csv
data/yale/*.RData
data/yale/*.csv
data/yale/ALL_COLUMNS.txt

# Credentialed data, should it ever arrive. The PhysioNet DUA forbids
# redistribution — this line exists before the directory does, on purpose.
data/mimic_full/

# The audit trail. Durable on the machine that produced it, never in git: it is
# a clinical record, and a shared one would let two deployments disagree about
# what happened. The schema is in layer3/store.py; the file rebuilds itself.
data/*.db
data/*.db-wal
data/*.db-shm

# The frozen model artifact IS tracked — ml/models/acuity.pkl and its manifest.
# A deployment that retrains at startup is not running a model anyone reviewed.

# --- Python -----------------------------------------------------------------
__pycache__/
*.pyc
.venv/
.pytest_cache/
.env

# personal notes / transcripts — not part of the deliverable
test.md

# Internal working material: the team's own PRD, reference mockups and voice
# notes. Useful while building, not part of what is being submitted.
docsfromsatyansh/

# Written material kept local: the demo script, the hosting walkthrough, the
# generated results and figures, the plain-words PDF. The README carries what a
# reader of the repository needs; these are working documents for the team.
#
# `make report` regenerates docs/results.md and the figures, so nothing here is
# lost by not tracking it.
docs/

# Agent instruction files. AGENTS.md is rewritten by `next dev` on every run,
# so ignoring it is the only way to keep it out of a diff for good.
CLAUDE.md
AGENTS.md

# --- Next.js client ---------------------------------------------------------
atria-web/node_modules/
atria-web/.next/
atria-web/out/
atria-web/.env*.local
atria-web/next-env.d.ts
